# ============================================================
# NexusLoop V1.2 — Multi-LLM configuration
# Copy to .env. NEVER commit real keys.
# ============================================================

NEXUSLOOP_ENV=demo

# Provider: auto | openai | anthropic | gemini | openai_compatible | ollama
# auto = pick the first configured provider in NEXUSLOOP_PROVIDER_PRIORITY.
NEXUSLOOP_AI_PROVIDER=auto

# auto     = use an available LLM, otherwise deterministic fallback
# fallback = never call an LLM; always use the built-in transparent planner
NEXUSLOOP_AI_MODE=auto

# If the selected provider fails, try another configured provider before fallback.
NEXUSLOOP_LLM_FAILOVER=true
NEXUSLOOP_PROVIDER_PRIORITY=openai,anthropic,gemini,openai_compatible,ollama

# ---------- OpenAI ----------
OPENAI_API_KEY=
# Fill a model ID supported by your OpenAI account.
OPENAI_MODEL=

# ---------- Anthropic Claude ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Usually leave this unchanged.
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ---------- Google Gemini ----------
GEMINI_API_KEY=
# GOOGLE_API_KEY is also accepted if GEMINI_API_KEY is empty.
GOOGLE_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# ---------- OpenAI-compatible provider ----------
# Useful for providers/gateways that expose an OpenAI-compatible chat endpoint.
# Examples can include some DeepSeek, Qwen, Mistral or enterprise gateways,
# depending on the provider's current API compatibility.
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=

# ---------- Local model through Ollama ----------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
